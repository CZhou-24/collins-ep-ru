#!/usr/bin/env wolframscript
(* Render the saved comparison rows as a compact markdown table.
   Reads numerical-comparison.wl written by compare_congyue_hard.wls. *)
$HistoryLength=0;
in=$ScriptCommandLine[[2]];out=$ScriptCommandLine[[3]];
data=Get[in];rows=data["rows"];audit=data["symbol_audit"];
flat[s_]:=StringReplace[StringTrim[ToString[s]],{"\n"->" ","\r"->" "}];
collapse[s_]:=StringReplace[s,RegularExpression["\\s+"]->" "];
num[v_,n_:10]:=If[NumberQ[v],collapse[flat[NumberForm[N[v,n],n]]],collapse[flat[v]]];
(* Plain mantissa-times-power text: ScientificForm's boxes do not survive a
   markdown table, and trailing precision marks are noise here. *)
sci[v_]:=Module[{m,e},Which[!NumberQ[v],collapse[flat[v]],v==0,"0",True,
  e=Floor[Log10[Abs[N[v]]]];m=N[v/10^e,4];
  ToString[NumberForm[m,4]]<>"e"<>ToString[e]]];
esc[s_]:=StringReplace[collapse[flat[s]],{"|"->"\\|"}];
order={"NUMERICAL AGREEMENT","NUMERICAL AGREEMENT (reduced precision)",
 "EXACT AT BOUNDARY (offset-independent)","REMOVABLE-LIMIT CONVERGENCE",
 "REMOVABLE-LIMIT CONVERGENCE (slow)","BOTH ZERO","DISCREPANCY","NO CONVERGENCE",
 "UNRESOLVED (non-numeric)"};
tally=Association@Table[v->Length[Select[rows,#["verdict"]===v&]],{v,order}];
tally=Select[tally,#>0&];
s=StringJoin[
 "# Comparison table\n\n",
 "Generated by `tools/checks/report_congyue_comparison.wls` from the saved\n",
 "`numerical-comparison.wl`. `ours` and `theirs` are the converted values\n",
 "actually compared; the conversions are documented in `README.md`. `rel` is\n",
 "`|ours-theirs|/max(|ours|,|theirs|)` at 60-digit working precision, except for\n",
 "the action rows, which are quadrature-limited, and the `x=z` limit rows, where\n",
 "`rel` is the error at offset `1e-10` and the verdict is the convergence ratio\n",
 "between offsets `1e-6` and `1e-10`.\n\n",
 "## Totals\n\n| verdict | rows |\n|---|---|\n",
 StringJoin[Table["| "<>k<>" | "<>ToString[tally[k]]<>" |\n",{k,Keys[tally]}]],
 "| **total** | **"<>ToString[Length[rows]]<>"** |\n\n",
 "## Rows\n\n| comparison | point | ours | theirs | rel | verdict |\n|---|---|---|---|---|---|\n",
 StringJoin[Table["| "<>esc[r["comparison"]]<>" | "<>esc[r["point"]]<>" | "<>
   num[r["ours"]]<>" | "<>num[r["theirs"]]<>" | "<>sci[r["relative_difference"]]<>" | "<>
   r["verdict"]<>" |\n",{r,rows}]],
 "\n## Removable-boundary convergence detail\n\n",
 "| comparison | point | error at offset 1e-6 | error at offset 1e-10 | ratio |\n|---|---|---|---|---|\n",
 StringJoin[Table["| "<>esc[r["comparison"]]<>" | "<>esc[r["point"]]<>" | "<>
   sci[r["error_at_1e-6"]]<>" | "<>sci[r["error_at_1e-10"]]<>" | "<>
   sci[r["error_ratio"]]<>" |\n",{r,Select[rows,KeyExistsQ[#,"error_ratio"]&]}]],
 "\n## Residual free symbols after conversion\n\n| expression | residual symbols |\n|---|---|\n",
 StringJoin[Table["| "<>esc[a["expression"]]<>" | "<>esc[a["residual_symbols"]]<>" |\n",{a,audit}]]];
Export[out,s,"Text"];
Print["wrote ",out," with ",Length[rows]," rows"];
Do[Print["  ",StringPadRight[k,42],tally[k]],{k,Keys[tally]}];
Exit[0];

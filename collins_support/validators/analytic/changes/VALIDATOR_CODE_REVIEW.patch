+#!/usr/bin/env python3
+"""Adopt the existing partial RU engine without changing any source or old state."""
+import argparse,json
+from pathlib import Path
+from ru_support import *
+from workflow import check_reuse
+
+def check_previous_release(folder):
+    folder=Path(folder).resolve();pin=read(ROOT/'previous_v050.json')
+    manifest=folder/'MANIFEST.json'
+    if digest(manifest)!=pin['manifest_sha256']:raise ValueError('wrong v0.5.0 manifest')
+    expected=read(ROOT/'history/v0.5.0-MANIFEST.json')
+    if read(manifest)!=expected:raise ValueError('wrong previous release inventory')
+    actual={p.relative_to(folder).as_posix():digest(p) for p in folder.rglob('*')
+            if p.is_file() and '__pycache__' not in p.parts and p.suffix!='.pyc' and p!=manifest}
+    if actual!=expected['files']:raise ValueError('previous validator changed')
+    return {'path':str(folder),'manifest_sha256':digest(manifest),'files':len(actual)}
+
+def upgrade(a):
+    release=release_integrity();repo=Path(a.repo).resolve();prod=repo/ENGINE
+    previous_state=Path(a.previous_state).resolve();previous_validator=Path(a.previous_validator).resolve()
+    old_release=check_previous_release(previous_validator)
+    adoption_path=previous_state/'adoption.json';adoption=read(adoption_path)
+    if adoption.get('schema')!=5 or adoption.get('status')!='INSTALLED_INTERFACE' or adoption.get('repo')!=str(repo) or adoption.get('implementation')!=str(prod) or adoption.get('release')!=old_release['manifest_sha256']:
+        raise ValueError('previous adoption does not identify this repo/release')
+    selected=a.accepted_pair or adoption['accepted']['pair']
+    accepted=accepted_pair(repo,selected)
+    if accepted!=adoption.get('accepted'):raise ValueError('accepted evidence changed since v0.5.0 adoption')
+    state=disjoint(a.state,[repo,ROOT,previous_validator,previous_state,Path(selected).resolve().parent])
+    if state.exists():raise ValueError('choose a new v0.5.1 state directory; no overwrite')
+    if digest(contained(prod,'common/ru_io.wl'))!=digest(ROOT/'native_io.wl'):
+        raise ValueError('existing RU transport helper differs; upgrade never replaces it')
+    reuse=check_reuse(prod);rt=runtime(repo)
+    before=snapshot(prod);prior=snapshot(previous_state);sidis=upstream_source_state(repo)
+    result={'schema':5,'status':'DRY_RUN' if a.dry_run else 'UPGRADE_READY',
+            'release':release,'repo':str(repo),'implementation':str(prod),'accepted':accepted,
+            'previous_validator':old_release,'previous_state':str(previous_state),
+            'previous_adoption_sha256':digest(adoption_path),'initial_source_hash':identity(before),
+            'previous_state_hash':identity(prior),'runtime':rt,'reuse':reuse,'sidis_sources':sidis,
+            'source_changes':[],'note':'Only new-state adoption/snapshots are written. No physics acceptance or old-evidence promotion.'}
+    if not a.dry_run:
+        state.mkdir(parents=True,exist_ok=False)
+        write(state/'initial-engine-snapshot.json',before)
+        write(state/'previous-state-snapshot.json',prior)
+        if before!=snapshot(prod) or prior!=snapshot(previous_state) or sidis!=upstream_source_state(repo):
+            raise ValueError('sources or previous state changed during upgrade')
+        check_previous_release(previous_validator);preserve_old(repo);release_integrity()
+        write(state/'adoption.json',result)
+    print(json.dumps(result,indent=2));return 0
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--repo',default='/bigTMD')
+    p.add_argument('--state',default='/Collins-ep-analytic-state-v0.5.1')
+    p.add_argument('--previous-validator',default='/Collins-ep-analytic-validation-v0.5.0')
+    p.add_argument('--previous-state',default='/Collins-ep-analytic-state-v0.5.0')
+    p.add_argument('--accepted-pair')
+    p.add_argument('--dry-run',action='store_true')
+    try:return upgrade(p.parse_args())
+    except Exception as exc:r,c=error_result(exc);print(json.dumps(r));return c
+if __name__=='__main__':raise SystemExit(main())
